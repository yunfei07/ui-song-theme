{
  "name": "ui-song-theme",
  "version": "0.1.0",
  "description": "Song-inspired light and dark theme plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "song-dynasty",
    "chinese-aesthetics"
  ],
  "homepage": "https://github.com/yunfei07/ui-song-theme#readme",
  "bugs": {
    "url": "https://github.com/yunfei07/ui-song-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfei07/ui-song-theme.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./tokens": {
      "types": "./lib/types/client/theme.d.ts",
      "default": "./lib/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/tokens.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json && vitest run",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --cache .npm-cache"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
